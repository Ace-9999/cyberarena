# ============================================================
#  CyberArena backend environment
#  Copy this file to ".env" and fill in the real values.
#  (cp .env.example .env  —  the .env file is git-ignored)
# ============================================================

# Supabase Postgres connection string.
# Dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" string (works from IPv4 home networks).
# Remember to replace [YOUR-PASSWORD] with your DB password.
# Example:
# DATABASE_URL=postgresql://postgres.abcxyz:YOURPASS@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How long a login session stays valid (days).
JWT_EXPIRE_DAYS=7

# Bonus points awarded for being the FIRST to solve a challenge.
FIRST_BLOOD_BONUS=25

# Challenge container hardening defaults.
# Keep challenge containers reachable only from the host machine by default.
CHALLENGE_BIND_HOST=127.0.0.1
CHALLENGE_NETWORK_NAME=cyberarena-challenges
CHALLENGE_NETWORK_INTERNAL=false
CHALLENGE_MEMORY_LIMIT=256m
CHALLENGE_NANO_CPUS=500000000
CHALLENGE_PIDS_LIMIT=64
